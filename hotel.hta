<!--
  士为大酒店 · 酒店实习模拟 v3.2
  修复内容：
  1. CSS linear-gradient → 纯色（兼容IE）
  2. JS全 Unicode转义（兼容JScript）
  3. 音频改用 window.speechSynthesis
  4. 好评事件改为飘字模式（随机4方向滚动）
  5. 新增20个问题，修正所有错别字
  6. 得分音效：好=恭喜/坏=遗憾
-->
<html>
<head>
<meta charset="utf-8">
<meta http-equiv="x-ua-compatible" content="IE=Edge">
<hta:application id="hotelApp" applicationname="HotelSim" version="3.2" caption="yes" showintaskbar="yes" icon="hotel.ico" scroll="no" contextmenu="no" singleinstance="yes" windowstate="normal"/>
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{width:100%;height:100%;font-family:'Microsoft YaHei','SimHei',sans-serif;background:#0d0d1a;color:#f5f5f5}
.sbg{position:fixed;inset:0;background:#0d0d1a;z-index:0}
.ss{position:absolute;inset:0;background-image:radial-gradient(1px 1px at 10% 10%,#fff5,transparent),radial-gradient(1px 1px at 30% 20%,#fff5,transparent),radial-gradient(1px 1px at 50% 5%,#fff5,transparent),radial-gradient(1px 1px at 70% 15%,#fff5,transparent),radial-gradient(1px 1px at 90% 8%,#fff5,transparent);animation:tw 3s infinite alternate}
@keyframes tw{0%{opacity:.4}100%{opacity:1}}
.app{position:relative;z-index:1;min-height:100vh;display:flex;flex-direction:column}
.sr{height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:24px;text-align:center;position:relative}
.cs{width:480px;max-width:90vw;height:200px;background:#1a1a3a;border:2px solid #3a3a5a;border-radius:12px;margin-bottom:20px;overflow:hidden;display:flex;align-items:center;justify-content:center;position:relative}
.er{position:absolute;top:10px;left:0;right:0;display:flex;justify-content:center;gap:16px;font-size:24px;animation:fe 3s ease-in-out infinite}
@keyframes fe{0%,100%{transform:translateY(0)}50%{transform:translateY(-6px)}}
.ha{position:relative;width:200px;height:140px;display:flex;flex-direction:column;align-items:center;justify-content:flex-end}
.roof{width:140px;height:30px;background:#f4d03f;clip-path:polygon(10% 100%,90% 100%,100% 0,0 0);display:flex;align-items:center;justify-content:center}
.sign{font-size:9px;color:#1a1a3a;font-weight:bold;letter-spacing:1px;font-family:'SimHei'}
.body{width:120px;height:60px;background:#2a2f4a;border:3px solid #f4d03f;border-bottom:none;display:grid;grid-template-columns:repeat(6,1fr);grid-template-rows:repeat(3,1fr);gap:2px;padding:4px}
.win{background:#f4d03f;border-radius:1px;opacity:.8;animation:wf 2s infinite alternate}
.off{background:#1a1a3a;opacity:.3}
@keyframes wf{0%{opacity:.7}50%{opacity:1}100%{opacity:.6}}
.dr{width:20px;height:25px;background:#1a1a3a;border:2px solid #f4d03f;border-bottom:none;margin-bottom:-3px}
.lb{width:120px;height:20px;background:#2a2f4a;border:3px solid #f4d03f;border-top:none;display:flex;align-items:center;justify-content:center;gap:8px}
.lw{width:12px;height:10px;background:#f4d03f;opacity:.6;border-radius:1px}
.cs2{position:absolute;bottom:8px;left:0;right:0;display:flex;justify-content:center;gap:12px;font-size:16px}
.tt{font-family:'SimHei';font-size:40px;font-weight:bold;color:#f4d03f;margin-bottom:4px;letter-spacing:8px;text-shadow:0 0 30px rgba(244,208,63,.5),0 2px 4px rgba(0,0,0,.5)}
.ts{font-size:11px;color:#888;letter-spacing:4px;margin-bottom:24px}
.bt{background:#f4d03f;color:#0d0d1a;border:none;padding:16px 52px;border-radius:10px;font-size:17px;font-weight:bold;font-family:'SimHei';letter-spacing:4px;cursor:pointer;transition:all .3s;box-shadow:0 4px 24px rgba(244,208,63,.4);margin-bottom:10px}
.bt:hover{transform:translateY(-3px);box-shadow:0 8px 36px rgba(244,208,63,.6)}
.tp{font-size:12px;color:#888;margin-bottom:8px}
.sr2{display:flex;gap:12px;align-items:center;justify-content:center;margin-bottom:28px}
.sb{padding:8px 16px;border-radius:6px;cursor:pointer;font-size:12px;font-weight:bold;font-family:'SimHei';border:1px solid #3a3a5a;background:rgba(255,255,255,.05);color:#888;transition:all .2s}
.sb.on{background:rgba(244,208,63,.15);border-color:#f4d03f;color:#f4d03f}
.hdr{display:flex;align-items:center;justify-content:space-between;padding:10px 16px;background:#0a0a1a;border-bottom:2px solid #3a3a5a;position:sticky;top:0;z-index:100}
.hn{font-size:14px;color:#f4d03f;font-weight:bold;letter-spacing:2px;font-family:'SimHei'}
.hn small{display:block;font-size:9px;color:#888;letter-spacing:1px}
.sr3{display:flex;gap:12px;align-items:center}
.sb2{text-align:center;background:rgba(255,255,255,.05);border:1px solid #3a3a5a;border-radius:4px;padding:4px 8px;min-width:52px}
.sb2 .l{font-size:8px;color:#888;display:block;text-transform:uppercase}
.sb2 .v{font-size:14px;font-weight:bold;display:block}
.vg{color:#f4d03f}.vr{color:#e57373}
.tw{padding:8px 16px 0}
.tb{height:8px;background:rgba(255,255,255,.1);border-radius:4px;overflow:hidden}
.tbr{height:100%;border-radius:4px;transition:width .3s;background:#4fc3f7}
.tbr.mid{background:#f4d03f}
.tbr.low{background:#e57373}
.tl{text-align:center;font-size:11px;color:#888;margin-top:2px}
.main{flex:1;padding:12px 16px;display:flex;flex-direction:column;gap:12px;overflow:hidden;position:relative}
.ql{font-size:10px;color:#f4d03f;text-transform:uppercase;letter-spacing:2px;margin-bottom:6px;display:flex;align-items:center;gap:6px}
.ql::before,.ql::after{content:'';flex:1;height:1px;background:#3a3a5a}
.eq{display:grid;grid-template-columns:repeat(auto-fill,minmax(110px,1fr));gap:8px}
.ec{background:rgba(255,255,255,.05);border:1px solid #3a3a5a;border-radius:6px;padding:8px;cursor:pointer;transition:all .2s;position:relative;overflow:hidden;animation:ci .3s ease-out}
@keyframes ci{from{opacity:0;transform:scale(.8)}to{opacity:1;transform:scale(1)}}
.ec:hover{border-color:#f4d03f;background:rgba(244,208,63,.08);transform:translateY(-2px)}
.ec.ur{border-color:#e57373;animation:up 1s infinite,ci .3s ease-out}
@keyframes up{0%,100%{box-shadow:0 0 0 0 rgba(229,115,115,.4)}50%{box-shadow:0 0 0 4px rgba(229,115,115,0)}}
.cy{font-size:26px;display:block;text-align:center;margin-bottom:4px}
.ct{font-size:11px;font-weight:bold;color:#f5f5f5;display:block;text-align:center;font-family:'SimHei'}
.cs3{font-size:9px;color:#888;display:block;text-align:center;margin-top:2px}
.cb{position:absolute;top:4px;right:4px;font-size:9px;padding:1px 4px;border-radius:3px;font-weight:bold}
.cbu{background:rgba(229,115,115,.3);color:#e57373}
.cbn{background:rgba(129,199,132,.3);color:#81c784}
.ae{background:rgba(255,255,255,.05);border:2px solid #3a3a5a;border-radius:8px;padding:16px;animation:su .3s ease-out;max-height:280px;overflow-y:auto}
@keyframes su{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:translateY(0)}}
.ah{display:flex;align-items:center;gap:12px;margin-bottom:12px}
.af{width:64px;height:64px;border-radius:8px;overflow:hidden;background:rgba(0,0,0,.4);border:2px solid #3a3a5a;display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:48px}
.at{font-size:14px;font-weight:bold;color:#f4d03f;margin-bottom:2px;font-family:'SimHei'}
.an{font-size:11px;color:#888;margin-bottom:6px}
.am{margin-left:auto;padding:3px 8px;border-radius:10px;font-size:11px;font-weight:bold;flex-shrink:0}
.ma{background:rgba(229,115,115,.2);color:#e57373}
.mh{background:rgba(129,199,132,.2);color:#81c784}
.mn{background:rgba(255,255,255,.1);color:#888}
.ad{background:rgba(0,0,0,.3);border-left:3px solid #f4d03f;padding:10px 12px;border-radius:0 6px 6px 0;font-size:13px;line-height:1.6;margin-bottom:14px}
.chs{display:flex;flex-direction:column;gap:8px}
.cb2{background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.12);color:#f5f5f5;padding:11px 12px;border-radius:6px;cursor:pointer;font-size:13px;text-align:left;transition:all .15s;font-family:'SimHei';line-height:1.5;display:block;width:100%}
.cb2:hover{background:rgba(244,208,63,.1);border-color:#f4d03f;transform:translateX(4px)}
.cb2:active{transform:translateX(2px) scale(.98)}
.ne{text-align:center;padding:40px 20px;color:#888;background:rgba(255,255,255,.05);border:1px dashed #3a3a5a;border-radius:8px}
.ne2{font-size:48px;display:block;margin-bottom:8px;animation:bc 2s infinite}
@keyframes bc{0%,100%{transform:translateY(0)}50%{transform:translateY(-10px)}}
.ne3{font-size:13px;font-family:'SimHei'}
.lp{background:rgba(255,255,255,.05);border:1px solid #3a3a5a;border-radius:8px;padding:10px 14px;max-height:90px;overflow-y:auto}
.lt{font-size:10px;color:#f4d03f;text-transform:uppercase;letter-spacing:2px;margin-bottom:8px}
.ll{font-size:10px;line-height:1.8;color:#888}
.li{padding:2px 0;border-bottom:1px solid rgba(255,255,255,.03)}
.pos{color:#81c784}.neg{color:#e57373}.gold{color:#f4d03f}
.cb3{position:fixed;top:80px;right:16px;z-index:150;background:rgba(244,208,63,.15);border:1px solid #f4d03f;border-radius:8px;padding:6px 12px;text-align:center;animation:cbi .3s ease-out;display:none}
@keyframes cbi{from{opacity:0;transform:scale(.8) translateX(20px)}to{opacity:1;transform:scale(1) translateX(0)}}
.cc{font-size:22px;font-weight:bold;color:#f4d03f}
.cl{font-size:9px;color:#888;text-transform:uppercase}
.sp{position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);font-size:28px;font-weight:bold;z-index:300;pointer-events:none;opacity:0}
.sp.anim{animation:sa 1s ease-out forwards}
@keyframes sa{0%{opacity:1;transform:translate(-50%,-50%) scale(.5)}30%{opacity:1;transform:translate(-50%,-60%) scale(1.2)}100%{opacity:0;transform:translate(-50%,-100%) scale(1)}}
.ov{display:none;position:fixed;inset:0;background:rgba(0,0,0,.85);z-index:200;align-items:center;justify-content:center;padding:16px}
.ov.ac{display:flex}
.bx{background:#131326;border:2px solid #f4d03f;border-radius:12px;padding:28px 24px;max-width:420px;width:100%;text-align:center;animation:mi .4s ease-out}
@keyframes mi{from{opacity:0;transform:scale(.85) translateY(20px)}to{opacity:1;transform:scale(1) translateY(0)}}
.me{font-size:72px;display:block;margin-bottom:12px}
.mt{font-size:22px;color:#f4d03f;margin-bottom:8px;font-weight:bold;font-family:'SimHei'}
.ms{font-size:13px;color:#888;line-height:1.6;margin-bottom:16px}
.ms2{background:rgba(0,0,0,.4);border-radius:8px;padding:14px;margin-bottom:16px;text-align:left}
.mst{display:flex;justify-content:space-between;padding:4px 0;font-size:12px}
.mst .l{color:#888}.mst .v{color:#f4d03f;font-weight:bold}.mst .vg{color:#81c784}.mst .vr{color:#e57373}
.br{display:flex;gap:8px;justify-content:center;flex-wrap:wrap}
.btn{padding:10px 20px;border-radius:6px;cursor:pointer;font-size:13px;font-weight:bold;font-family:'SimHei';border:none;transition:all .2s}
.bp{background:#f4d03f;color:#0d0d1a}.bp:hover{background:#d4a500;transform:translateY(-2px)}
.es{width:120px;height:120px;margin:0 auto 12px;display:flex;align-items:center;justify-content:center;border-radius:12px;font-size:72px}
.sh{animation:shk .5s ease-out}
@keyframes shk{0%,100%{transform:translateX(0)}10%{transform:translateX(-8px)}20%{transform:translateX(8px)}30%{transform:translateX(-6px)}40%{transform:translateX(6px)}50%{transform:translateX(-4px)}60%{transform:translateX(4px)}70%{transform:translateX(-2px)}80%{transform:translateX(2px)}}
.fl-g{animation:flc .4s ease-out}@keyframes flc{0%{background:rgba(129,199,132,.3)}100%{background:transparent}}
.fl-r{animation:flw .4s ease-out}@keyframes flw{0%{background:rgba(229,115,115,.3)}100%{background:transparent}}
::-webkit-scrollbar{width:4px}::-webkit-scrollbar-track{background:transparent}::-webkit-scrollbar-thumb{background:#3a3a5a;border-radius:2px}
.hi{display:none!important}
@media(max-width:480px){.sr3{gap:6px}.sb2{min-width:42px;padding:3px 5px}.sb2 .v{font-size:12px}.eq{grid-template-columns:repeat(auto-fill,minmax(90px,1fr))}.cy{font-size:22px}.tt{font-size:28px;letter-spacing:3px}.hdr{padding:8px 12px}.cs{height:160px}}
/*** 好评飘字 ***/
.praise-banner{position:fixed;z-index:160;background:rgba(244,208,63,.95);color:#0d0d1a;padding:10px 18px;border-radius:8px;font-family:'SimHei';font-size:14px;font-weight:bold;cursor:pointer;box-shadow:0 4px 20px rgba(244,208,63,.5);display:none;white-space:nowrap;pointer-events:all}
.praise-banner:hover{transform:scale(1.04)}
.praise-banner.d0{top:20%;animation:banL 7s linear forwards}
.praise-banner.d1{top:20%;animation:banR 7s linear forwards}
.praise-banner.d2{top:15%;animation:banT 6s linear forwards}
.praise-banner.d3{top:auto;bottom:15%;animation:banB 6s linear forwards}
@keyframes banL{0%{left:-260px;opacity:1}90%{left:calc(100vw+260px);opacity:1}100%{left:calc(100vw+260px);opacity:0;display:none}}
@keyframes banR{0%{right:-260px;opacity:1}90%{right:calc(100vw+260px);opacity:1}100%{right:calc(100vw+260px);opacity:0;display:none}}
@keyframes banT{0%{top:-60px;opacity:1}90%{top:calc(100vh+60px);opacity:1}100%{top:calc(100vh+60px);opacity:0;display:none}}
@keyframes banB{0%{bottom:-60px;opacity:1}90%{bottom:calc(100vh+60px);opacity:1}100%{bottom:calc(100vh+60px);opacity:0;display:none}}
</style>
</head>
<body>
<div class="sbg"><div class="ss"></div></div>
<div class="app" id="app">
  <div id="startScreen" class="sr">
    <div class="cs">
      <div class="er"><span>&#x1F4CB;</span><span>&#x1F9F3;</span><span>&#x2B50;</span><span>&#x1F6A8;</span><span>&#x1F3F2;</span></div>
      <div class="ha">
        <div class="roof"><span class="sign">SHIWEI</span></div>
        <div class="body">
          <div class="win"></div><div class="win off"></div><div class="win"></div>
          <div class="win off"></div><div class="win"></div><div class="win"></div>
          <div class="win"></div><div class="win"></div><div class="win off"></div>
          <div class="win"></div><div class="win off"></div><div class="win"></div>
          <div class="win off"></div><div class="win"></div><div class="win"></div>
          <div class="win"></div><div class="win off"></div><div class="win"></div>
        </div>
        <div class="dr"></div>
        <div class="lb"><div class="lw"></div><div class="lw"></div><div class="lw"></div></div>
      </div>
      <div class="cs2">&#x1F31F; &#x1F3C6; &#x1F48E; &#x1F31F;</div>
    </div>
    <div class="tt">士为大酒店</div>
    <div class="ts">SHIWEI HOTEL &middot; INTERN SIMULATION</div>
    <button class="bt" onclick="startGame()">开始实习</button>
    <div class="tp">120秒 &middot; 多个酒店事件 &middot; 你的选择决定结局</div>
    <div class="sr2">
      <button class="sb on" id="bgmBtn" onclick="toggleBGM()">&#x1F3B5; 背景音乐 ON</button>
      <button class="sb on" id="sfxBtn" onclick="toggleSFX()">&#x1F50A; 音效 ON</button>
    </div>
  </div>

  <div id="gameScreen" class="hi">
    <div class="hdr">
      <div class="hn">&#x1F3E8; 士为大酒店<small>SHIWEI HOTEL</small></div>
      <div class="sr3">
        <div class="sb2"><span class="l">分数</span><span class="v vg" id="scoreEl">0</span></div>
        <div class="sb2"><span class="l">满意度</span><span class="v" id="satisEl">50%</span></div>
        <div class="sb2"><span class="l">声誉</span><span class="v" id="repEl">50</span></div>
        <div class="sb2"><span class="l">已解决</span><span class="v" id="solvedEl">0</span></div>
      </div>
    </div>
    <div class="tw">
      <div class="tb"><div class="tbr" id="timerBar"></div></div>
      <div class="tl">&#x23F1; <span id="timerText">120</span> 秒</div>
    </div>
    <div class="main">
      <div>
        <div class="ql">&#x1F4CB; 待处理事件 &middot; 点击处理</div>
        <div class="eq" id="eventQueue"></div>
      </div>
      <div id="activeEventArea">
        <div class="ne"><span class="ne2">&#x23F3;</span><div class="ne3">点击上方事件开始处理...</div></div>
      </div>
      <div class="lp">
        <div class="lt">&#x1F4DD; 实习日志</div>
        <div class="ll" id="logList"></div>
      </div>
    </div>
  </div>
</div>

<div class="cb3" id="comboDisplay">
  <div class="cc" id="comboCount">0</div>
  <div class="cl">连击</div>
</div>
<div class="sp" id="scorePopup"></div>
<div class="praise-banner" id="praiseBanner"></div>

<div class="ov" id="endModal">
  <div class="bx">
    <div class="es" id="endingScene"></div>
    <div class="me" id="endEmoji">&#x1F3C6;</div>
    <div class="mt" id="endTitle">实习结束</div>
    <div class="ms" id="endSub"></div>
    <div class="ms2" id="endStats"></div>
    <div class="br"><button class="btn bp" onclick="restartGame()">&#x1F504; 再来一次</button></div>
  </div>
</div>

<script language="JScript">
/* === AUDIO: window.speechSynthesis === */
var synth = null;
var bgmOn = true;
var sfxOn = true;

function initAudio() {
  if (synth) return;
  try { synth = window.speechSynthesis; } catch(e) { synth = null; }
}

function speak(text) {
  if (!synth || !sfxOn) return;
  try {
    var v = synth.getVoices();
    if (!v || v.length === 0) return;
    var u = new SpeechSynthesisUtterance(text);
    u.lang = 'zh-CN';
    u.rate = 1.1;
    u.volume = 0.8;
    synth.cancel();
    synth.speak(u);
  } catch(e) {}
}

function playGreat()  { speak('\u606D\u559C\uFF01\u4F60\u7684\u8868\u73B0\u592A\u68D2\u4E86\uFF01\u592A\u68D2\u4E86\uFF01'); }
function playOK()    { speak('\u52AA\u529B\u52A0\u6CB9\uFF0C\u4F1A\u66F4\u597D\u7684'); }
function playBad()   { speak('\u9057\u61BE\uFF0C\u4E0B\u6B21\u52AA\u529B\u5427'); }
function playGood()  { speak('\u89E3\u51B3\uFF01\u505A\u5F97\u597D\uFF01'); }
function playMiss()  { speak('\u7B54\u9519\u4E86\uFF0C\u518D\u52AA\u529B\u5427'); }
function playUrgent(){ speak('\u7D27\u6025\u60C5\u51B5\uFF0C\u7ACB\u5373\u5904\u7406'); }
function playPraise(){ speak('\u70B9\u8D5E\uFF01\u6536\u5230\u597D\u8BC4\uFF0C\u52A0\u5206\uFF01'); }
function playCombo(){ speak('\u8FDE\u51FB\uFF01'); }

function toggleBGM() {
  bgmOn = !bgmOn;
  var b = document.getElementById('bgmBtn');
  if (bgmOn) {
    b.innerText = '\uD83C\uDFB5 \u80CC\u666F\u97F3\u4E50 ON';
    b.className = 'sb on';
    if (synth) { try { synth.cancel(); } catch(e) {} }
  } else {
    b.innerText = '\uD83C\uDFB5 \u80CC\u666F\u97F3\u4E50 OFF';
    b.className = 'sb';
    if (synth) { try { synth.cancel(); } catch(e) {} }
  }
}

function toggleSFX() {
  sfxOn = !sfxOn;
  var b = document.getElementById('sfxBtn');
  if (sfxOn) {
    b.innerText = '\uD83D\uDD0A \u97F3\u6548 ON';
    b.className = 'sb on';
  } else {
    b.innerText = '\uD83D\uDD07 \u97F3\u6548 OFF';
    b.className = 'sb';
  }
}

