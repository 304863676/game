  /* ===== 好评飘字系统(PRAISE_EVENTS不在队列，由飘字系统随机触发) ===== */
];

/* === PRAISE BANNER DATA === */
var PRAISE_DATA = [
  {text:'\u2605 \u7F8E\u56E2\u5BA2\u4EBA\u53D1\u8868\u4E86\u8D5E\u4E0D\u7EDD\u53E3\u7684\u597D\u8BC4\uFF01 \u70B9\u51FB\u9886\u53D6+3\u5206 \u2601',color:'#4fc3f7'},
  {text:'\u2B50 \u6296\u97F3\u7EA2\u4EBA\u53D1\u5E03\u4E86\u70ED\u60C5\u5BA2\u5E01\u89C6\u9891\uFF01 \u70B9\u51FB\u9886\u53D6+3\u5206 \u2B50',color:'#81c784'},
  {text:'\u2605 \u5927\u4F17\u70B9\u5BA2\u4EBA\u7ED9\u4E86\u4E94\u661F\u597D\u8BC4\uFF01 \u70B9\u51FB\u9886\u53D6+3\u5206 \u2605',color:'#f4d03f'},
];

/* === GAME STATE === */
var state = null;
var _eid = 0;
var _recent = [];
var _praiseTimer = null;

function clamp(v,mn,mx){return Math.max(mn,Math.min(mx,v));}

function shuffle(arr) {
  var a = arr.slice();
  for (var i=a.length-1;i>0;i--){var j=Math.floor(Math.random()*(i+1));var t=a[i];a[i]=a[j];a[j]=t;}
  return a;
}

function makeEvent() {
  var pool = EVENTS.filter(function(e){return _recent.indexOf(e.type)===-1;});
  if(pool.length===0) pool=EVENTS;
  var t=pool[Math.floor(Math.random()*pool.length)];
  _recent.push(t.type);
  if(_recent.length>4)_recent.shift();
  var moods=['neutral','angry','happy'];
  return{id:'e'+(++_eid),type:t.type,emoji:t.emoji,name:t.name,dialogue:t.dialogue,guestName:t.guestName,avatar:t.avatar,mood:moods[Math.floor(Math.random()*3)],urgent:t.urgent,shuffledChoices:shuffle(t.choices.map(function(c,i){return{text:c.text,score:c.score,satisfaction:c.satisfaction,reputation:c.reputation,origIdx:i};}))};
}

/* === PRAISE BANNER === */
function showPraiseBanner() {
  if(!state||state.finished)return;
  var el=document.getElementById('praiseBanner');
  if(!el)return;
  var pe=PRAISE_DATA[Math.floor(Math.random()*PRAISE_DATA.length)];
  var dir=Math.floor(Math.random()*4);
  el.innerHTML=pe.text;
  el.style.background=pe.color;
  el.className='praise-banner d'+dir;
  el.style.display='block';
  el.style.left='';el.style.right='';el.style.top='';el.style.bottom='';el.style.transform='';
  if(dir===0){el.style.left='-260px';el.style.top=(15+Math.random()*50)+'%';}
  else if(dir===1){el.style.right='-260px';el.style.top=(15+Math.random()*50)+'%';}
  else if(dir===2){el.style.top='-60px';el.style.left='50%';el.style.transform='translateX(-50%)';}
  else{el.style.bottom='-60px';el.style.top='auto';el.style.left='50%';el.style.transform='translateX(-50%)';}
  el.onclick=collectPraise;
  setTimeout(function(){if(el)el.style.display='none';},6500);
}

function collectPraise() {
  var el=document.getElementById('praiseBanner');
  if(!el||el.style.display==='none')return;
  el.style.display='none';
  state.score+=3;
  state.satisfaction=clamp(state.satisfaction+5,0,100);
  state.reputation=clamp(state.reputation+3,0,100);
  showPopup('+3\u5206','#4fc3f7');
  log('\u2705 [\u597D\u8BC4\u4E8B\u4EF6] \u70B9\u8D5E+3\u5206','pos');
  playPraise();
  updateStats();
}

/* === RENDER === */
function renderQueue() {
  var q=document.getElementById('eventQueue');
  if(!q)return;
  if(state.events.length===0){q.innerHTML='<div style="color:#888;font-size:11px;padding:8px;">\u23F3 \u4E8B\u4EF6\u751F\u6210\u4E2D...</div>';return;}
  var html='';
  for(var i=0;i<state.events.length;i++){
    var ev=state.events[i];
    var cls=ev.urgent?' ec ur':' ec';
    var badge=ev.urgent?'<span class="cb cbu">\uD83D\uDED1\u7D27\u6025</span>':'<span class="cb cbn">\uD83D\uDCCB\u5E38\u89C1</span>';
    html+='<div class="'+cls+'" onclick="selectEvent(\''+ev.id+'\')">'+badge+'<div class="cy">'+ev.emoji+'</div><div class="ct">'+ev.name+'</div><div class="cs3">'+ev.guestName+'</div></div>';
  }
  q.innerHTML=html;
}

function renderActive() {
  var area=document.getElementById('activeEventArea');
  if(!area)return;
  if(!state.activeEvent){area.innerHTML='<div class="ne"><span class="ne2">\u23F3</span><div class="ne3">\u70B9\u51FB\u4E0A\u65B9\u4E8B\u4EF6\u5F00\u59CB\u5904\u7406...</div></div>';return;}
  var ev=state.activeEvent;
  var mc=ev.mood==='angry'?' ma':ev.mood==='happy'?' mh':' mn';
  var mt=ev.mood==='angry'?'\uD83D\uDE20 \u751F\u6C14':ev.mood==='happy'?'\uD83D\uDE0A \u6EE1\u610F':'\uD83D\uDE10 \u5E73\u9759';
  var ch='';
  for(var i=0;i<ev.shuffledChoices.length;i++){ch+='<button class="cb2" onclick="handleChoice('+i+')">'+ev.shuffledChoices[i].text+'</button>';}
  area.innerHTML='<div class="ae"><div class="ah"><div class="af">'+ev.avatar+'</div><div><div class="at">'+ev.emoji+' '+ev.name+'</div><div class="an">'+ev.guestName+'</div><div class="am'+mc+'">'+mt+'</div></div></div><div class="ad">\uD83D\uDCAC "'+ev.dialogue+'"</div><div class="chs">'+ch+'</div></div>';
}

function updateStats() {
  var el=document.getElementById('scoreEl');
  if(el)el.innerText=state.score;
  var sat=clamp(state.satisfaction,0,100);
  el=document.getElementById('satisEl');
  if(el){el.innerText=sat+'%';el.className='v '+(sat>=50?'':'vr');}
  el=document.getElementById('repEl');
  if(el){el.innerText=clamp(state.reputation,0,100);el.className='v '+(state.reputation>=50?'':'vr');}
  el=document.getElementById('solvedEl');
  if(el)el.innerText=state.solved;
  var pct=(state.timeLeft/120)*100;
  el=document.getElementById('timerBar');
  if(el){el.style.width=pct+'%';el.className='tbr'+(pct<=25?' low':pct<=50?' mid':'');}
  el=document.getElementById('timerText');
  if(el)el.innerText=state.timeLeft;
}

function showPopup(txt,color){
  var p=document.getElementById('scorePopup');
  if(!p)return;
  p.innerText=txt;p.style.color=color;p.className='sp';
  void p.offsetWidth;p.className='sp anim';
}

function triggerShake(){
  document.body.className='';
  void document.body.offsetWidth;
  document.body.className='sh';
  setTimeout(function(){document.body.className='';},600);
}

function triggerFlash(type){
  var el=document.querySelector('.ae');
  if(!el)return;
  void el.offsetWidth;
  el.className='ae '+(type==='good'?'fl-g':'fl-r');
  setTimeout(function(){if(el)el.className='ae';},400);
}

function showCombo(c){
  var cd=document.getElementById('comboDisplay');
  if(!cd)return;
  if(c<2){cd.style.display='none';return;}
  var el=document.getElementById('comboCount');
  if(el)el.innerText=c;
  cd.style.display='block';
  cd.style.animation='none';
  void cd.offsetWidth;
  cd.style.animation='cbi .3s ease-out';
}

function log(text,type){
  var list=document.getElementById('logList');
  if(!list)return;
  var item=document.createElement('div');
  item.className='li '+(type||'');
  item.innerText=text;
  if(list.firstChild)list.insertBefore(item,list.firstChild);
  else list.appendChild(item);
  while(list.children.length>20)list.removeChild(list.lastChild);
}

function ensureQueue(){while(state.events.length<5)state.events.push(makeEvent());renderQueue();}

function selectEvent(id){
  if(state.finished)return;
  var ev=null;
  for(var i=0;i<state.events.length;i++){if(state.events[i].id===id){ev=state.events[i];break;}}
  if(!ev)return;
  state.activeEvent=ev;
  renderActive();
}

function handleChoice(idx){
  if(state.finished||!state.activeEvent)return;
  var ev=state.activeEvent;
  var c=ev.shuffledChoices[idx];
  var bonus=0;
  if(c.score>0){state.combo++;state.bestCombo=Math.max(state.bestCombo,state.combo);bonus=state.combo*2;}
  else{state.combo=0;}
  state.score+=c.score+bonus;
  state.satisfaction=clamp(state.satisfaction+c.satisfaction,0,100);
  state.reputation=clamp(state.reputation+c.reputation,0,100);
  state.solved++;
  showCombo(state.combo);
  var total=c.score+bonus;
  var color=total>0?'#81c784':total<0?'#e57373':'#888';
  showPopup((total>0?'+':'')+total+'\u5206',color);
  if(c.score>5){playGood();triggerFlash('good');}
  else if(c.score<0){playMiss();triggerShake();triggerFlash('bad');}
  if(state.combo>=3)playCombo();
  log('['+ev.name+'] '+(c.score>0?'\uD83D\uDC4D':'\uD83D\uDE25')+' ('+(c.score>0?'+':'')+c.score+(bonus>0?'+'+bonus:'')+'\u5206)',c.score>5?'pos':c.score<0?'neg':'');
  state.events=state.events.filter(function(ee){return ee.id!==ev.id;});
  state.activeEvent=null;
  updateStats();renderQueue();renderActive();ensureQueue();
}

function startGame(){
  state={score:0,satisfaction:50,reputation:50,solved:0,timeLeft:120,events:[],activeEvent:null,combo:0,bestCombo:0,finished:false,timerID:null,spawnID:null};
  _eid=0;_recent=[];
  document.getElementById('startScreen').className='sr hi';
  document.getElementById('gameScreen').className='';
  document.getElementById('endModal').className='ov';
  document.getElementById('logList').innerHTML='';
  var cd=document.getElementById('comboDisplay');
  if(cd)cd.style.display='none';
  var pb=document.getElementById('praiseBanner');
  if(pb)pb.style.display='none';
  updateStats();ensureQueue();
  setTimeout(function(){if(state.events.length>0&&!state.activeEvent)selectEvent(state.events[0].id);},300);
  log('\uD83C\uDFC1 120\u79D2\u5F00\u59CB\uFF01\u52A0\u6CB9\uFF01','gold');
  if(bgmOn)speak('\u5F00\u59CB\u5427\uFF01\u52A0\u6CB9\uFF01');
  state.timerID=setInterval(function(){state.timeLeft--;updateStats();if(state.timeLeft<=0)endGame();},1000);
  state.spawnID=setInterval(function(){
    if(!state.finished){
      if(Math.random()<0.35&&state.events.length>2)state.events.splice(Math.floor(Math.random()*state.events.length),1);
      ensureQueue();
    }
  },2500);
  schedulePraise();
}

function schedulePraise(){
  if(state.finished)return;
  _praiseTimer=setTimeout(function(){
    if(!state.finished)showPraiseBanner();
    schedulePraise();
  },8000+Math.floor(Math.random()*7000));
}

/* === ENDINGS === */
var ENDINGS=[
  {minScore:350,title:'\uD83C\uDF1F 7\u661F\u4F18\u79C0\u5B9E\u4E60\u751F',sub:'\u4F60\u7684\u8868\u73B0\u7B97\u4E0A\u4F20\u5947\uFF01\u603B\u7ECF\u7406\u5F53\u573A\u51B3\u5B9A\u8DF3\u8FC7\u8BD5\u7528\u671F\uFF0C\u76F4\u63A5\u5F52\u5F52\u4E3A\u6B63\u5F0F\u5458\u5DE5\uFF0C\u5E76\u6388\u4E88\u201C\u6700\u4F73\u670D\u52A1\u4E4B\u661F\u201D\u8363\uFF01',emoji:'\uD83C\uDF96',sceneColor:'#f4d03f'},
  {minScore:220,title:'\u2B50 \u4F18\u79C0\u5B9E\u4E60\u751F',sub:'\u4F60\u7684\u670D\u52A1\u610F\u8BC6\u548C\u670D\u52A1\u6280\u5DE7\u90FD\u8868\u73B0\u4F18\u5F02\uFF01\u5E26\u8A00\u8001\u5E08\u7ED9\u4E86\u4F60\u6781\u9AD8\u7684\u8BC4\u4EF7\uFF0C\u5E76\u63A8\u8350\u4F60\u53C2\u52A0\u96C6\u56E2\u4F18\u79C0\u5458\u5DE5\u8BC4\u9009\u3002',emoji:'\u2B50',sceneColor:'#4fc3f7'},
  {minScore:130,title:'\uD83D\uDC4D \u5408\u683C\u5B9E\u4E60\u751F',sub:'\u4F60\u987A\u5229\u5B8C\u6210\u4E86\u5B9E\u4E60\u4EFB\u52A1\uFF0C\u57FA\u672C\u7D20\u8D28\u626C\u5B9E\u3002\u7EE7\u7EED\u52AA\u529B\uFF0C\u4E0B\u6B21\u8868\u73B0\u4F1A\u66F4\u597D\uFF01',emoji:'\uD83D\uDC4D',sceneColor:'#81c784'},
  {minScore:50,title:'\uD83D\uDE43 \u52B3\u7B3A\u53CA\u683C',sub:'\u4F60\u7684\u8868\u73B0\u5DEE\u5F3A\u4E0D\u610F\uFF0C\u6709\u4E9B\u5730\u65B9\u8FD8\u9700\u8981\u6539\u8FDB\u3002\u4E0D\u8981\u6CA6\u5C3D\uFF0C\u591A\u79EF\u7D2F\u7ECF\u9A8C\u4F1A\u8D8A\u6765\u8D8A\u597D\u7684\uFF01',emoji:'\uD83D\uDE43',sceneColor:'#ffb74d'},
  {minScore:-9999,title:'\uD83D\uDEAB \u5B9E\u4E60\u4E0D\u53CA\u683C',sub:'\u5F88\u9057\u61BE\uFF0C\u8FD9\u6B21\u5B9E\u4E60\u8868\u73B0\u672A\u8FBE\u5230\u57FA\u672C\u8981\u6C42\u3002\u4E5F\u8BB8\u9152\u5E97\u4EA7\u4E1A\u4E0D\u592A\u9002\u5408\u4F60\uFF0C\u5EFA\u8BAE\u8003\u8651\u5176\u4ED6\u65B9\u5411\u3002',emoji:'\uD83D\uDEAB',sceneColor:'#e57373'},
];

function endGame(){
  if(state.finished)return;
  state.finished=true;
  if(state.timerID)clearInterval(state.timerID);
  if(state.spawnID)clearInterval(state.spawnID);
  if(_praiseTimer)clearTimeout(_praiseTimer);
  var pb=document.getElementById('praiseBanner');
  if(pb)pb.style.display='none';
  var en=ENDINGS[ENDINGS.length-1];
  for(var i=0;i<ENDINGS.length;i++){if(state.score>=ENDINGS[i].minScore)en=ENDINGS[i];}
  document.getElementById('endEmoji').innerText=en.emoji;
  document.getElementById('endTitle').innerText=en.title;
  document.getElementById('endSub').innerText=en.sub;
  var scene=document.getElementById('endingScene');
  scene.innerHTML='<div style="font-size:72px">'+en.emoji+'</div>';
  scene.style.background='#1a1a2e';
  scene.style.border='2px solid '+en.sceneColor;
  var sat=clamp(state.satisfaction,0,100);
  var rep=clamp(state.reputation,0,100);
  document.getElementById('endStats').innerHTML=
    '<div class="mst"><span class="l">\u6700\u7EC8\u5206\u6570</span><span class="v">'+state.score+'</span></div>'+
    '<div class="mst"><span class="l">\u89E3\u51B3\u4E8B\u4EF6</span><span class="v vg">'+state.solved+'\u4EF6</span></div>'+
    '<div class="mst"><span class="l">\u5BA2\u6237\u6EE1\u610F\u5EA6</span><span class="v '+(sat>=50?'vg':'vr')+'">'+sat+'%</span></div>'+
    '<div class="mst"><span class="l">\u9152\u5E97\u58F0\u8BBF</span><span class="v '+(rep>=50?'vg':'vr')+'">'+rep+'</span></div>'+
    '<div class="mst"><span class="l">\u6700\u4F73\u8FDE\u51FB</span><span class="v">'+state.bestCombo+'\u8FDE\u51FB</span></div>';
  document.getElementById('endModal').className='ov ac';
  if(state.score>=220)playGreat();
  else if(state.score>=50)playOK();
  else playBad();
}

function restartGame(){
  document.getElementById('endModal').className='ov';
  startGame();
}

function onFirstClick(){
  initAudio();
  if(document.removeEventListener)document.removeEventListener('click',onFirstClick);
  else if(document.detachEvent)document.detachEvent('onclick',onFirstClick);
}
if(document.addEventListener)document.addEventListener('click',onFirstClick,false);
else if(document.attachEvent)document.attachEvent('onclick',onFirstClick);
</script>
</body>
</html>
